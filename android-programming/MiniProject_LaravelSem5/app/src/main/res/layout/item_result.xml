<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <data>
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="18dp"
        android:paddingBottom="18dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/line" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txtItemNumber"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/review_question_default"
                android:textColor="@color/ink"
                android:textStyle="bold"
                android:textSize="22sp"
                android:fontFamily="sans-serif-condensed" />

            <ImageView
                android:id="@+id/imgItemStatus"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_correct"
                android:contentDescription="@string/feedback_icon_desc" />

            <TextView
                android:id="@+id/txtItemStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/status_correct"
                android:textColor="@color/success"
                android:textStyle="bold"
                android:textSize="12sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/txtItemQuestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/question_placeholder"
            android:textColor="@color/ink"
            android:textStyle="bold"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/txtYourAnswer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/your_answer_default"
            android:textColor="@color/body_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txtCorrectAnswer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/correct_answer_default"
            android:textColor="@color/success"
            android:textSize="14sp" />

    </LinearLayout>
</layout>
